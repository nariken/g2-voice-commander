# Personal sideload only — these are embedded in the client bundle at build time.
# Gemini API key: https://aistudio.google.com  (Get API key)
VITE_GEMINI_API_KEY=
# Linear personal API key (needs write): Linear → Settings → Security & access → Personal API keys
VITE_LINEAR_API_KEY=
# Linear team UUID that new issues/PRDs are created in.
# Find it: open any issue in that team → its API id, or query `teams { id key name }` in the Linear API.
VITE_LINEAR_TEAM_ID=
