# Local secrets for `wrangler dev` (copy to .dev.vars, never commit).
# In production set these with `wrangler secret put <NAME>`.
GEMINI_API_KEY=
LINEAR_API_KEY=
LINEAR_TEAM_ID=
APP_TOKEN=
# Google Calendar (optional — the "予定" action). Get these via scripts/google-oauth.mjs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# GitHub (optional — the "実装" action / Stage 3). Fine-grained PAT with Issues:write.
GITHUB_TOKEN=
GITHUB_REPO=nariken/g2-voice-commander
